LOG_LEVEL=INFO
LOG_FORMAT=console
# development allows SHELFMARK_AUTH=local (one local user, no sign-in).
# Production is the default and requires Sign in with Amp to be configured.
SHELFMARK_ENV=development
SHELFMARK_AUTH=local
SHELFMARK_DATA_DIR=.data
# DATABASE_URL=sqlite+aiosqlite:///./.data/shelfmark.sqlite3
SHELFMARK_REFRESH_MINUTES=20

# Sign in with Amp (SHELFMARK_AUTH=amp). Redirect URI defaults to
# $AMP_DEPLOYMENT_URL/auth/callback on a Box.
# AMP_OAUTH_CLIENT_ID=
# AMP_OAUTH_CLIENT_SECRET=
# APP_SESSION_SECRET=   # at least 32 random characters
# AMP_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
# SHELFMARK_ALLOWED_USER_IDS=user_01...
