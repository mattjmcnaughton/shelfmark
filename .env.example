LOG_LEVEL=INFO
LOG_FORMAT=console
# development allows SHELFMARK_AUTH=local (one local user, no sign-in).
# Production is the default and requires Sign in with Auth0 to be configured.
SHELFMARK_ENV=development
SHELFMARK_AUTH=local
SHELFMARK_DATA_DIR=.data
# DATABASE_URL=sqlite+aiosqlite:///./.data/shelfmark.sqlite3
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost/shelfmark
SHELFMARK_REFRESH_MINUTES=20

# Sign in with Auth0 (SHELFMARK_AUTH=auth0). Redirect URI defaults to
# $AMP_DEPLOYMENT_URL/auth/callback on a Box.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=
# APP_SESSION_SECRET=   # at least 32 random characters
# AUTH0_REDIRECT_URI=http://localhost:8000/auth/callback
# SHELFMARK_ALLOWED_USER_IDS=google-oauth2|1234...,auth0|abc...
